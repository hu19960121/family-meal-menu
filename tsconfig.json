{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "jsx": "preserve", "resolveJsonModule": true,
    "isolatedModules": true, "esModuleInterop": true,
    "lib": ["ESNext", "DOM"], "skipLibCheck": true, "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".", "paths": { "@/*": ["./family-meal-menu/src/*"] },
    "types": ["@dcloudio/types"]
  },
  "include": ["family-meal-menu/src/**/*.ts", "family-meal-menu/src/**/*.d.ts", "family-meal-menu/src/**/*.vue"]
}
